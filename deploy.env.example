# Copy this file to deploy.env (gitignored) and fill in real values.
# Never commit deploy.env, never paste its contents into a chat or shared terminal.

FTP_HOST=ftp.techfullness.com
FTP_USER='weather_ftp@weather.sollebrunn.net'
FTP_PASS='CHANGE_ME'
# Quote values that contain special characters (#, $, spaces, &, ...) -
# this file is sourced by bash, and unquoted specials get misinterpreted
# (a '#' silently truncates everything after it, for example).

# Remote path that corresponds to this repo's root, i.e. where index.php etc.
# already live on the server. Usually just /meteo/ or /public_html/meteo/
# depending on how the FTP account's home directory is set up - check in
# cPanel -> FTP Accounts, or just try /meteo/ first.
FTP_REMOTE_BASE=/meteo/
